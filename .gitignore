# ── Python ───────────────────────────────────────────────────────────────────
# Created whenever uuid_v7.py is imported as a module (not when run directly).
__pycache__/
*.py[cod]

# ── Ruby ─────────────────────────────────────────────────────────────────────
*.gem
.bundle/
vendor/bundle/

# ── Lua ──────────────────────────────────────────────────────────────────────
# Only relevant if luaposix/luasocket are ever installed locally rather than
# system-wide; uuid_v7.lua detects them at load time and works without them.
*.rock
.luarocks/
lua_modules/

# ── JavaScript ───────────────────────────────────────────────────────────────
# uuid_v7.js has no dependencies; this only guards against a stray install.
node_modules/
package-lock.json

# ── Benchmark ────────────────────────────────────────────────────────────────
# bench/run.sh builds the two compiled drivers next to their sources.
/bench/bench_rs
/bench/bench_c

# ── C ────────────────────────────────────────────────────────────────────────
# uuid_v7.c is compiled by hand (cc -std=c11 -O2 -pthread uuid_v7.c -o uuid_v7_c),
# so the binary lands right next to the source. The two compiled siblings use
# distinct output names on purpose, so building both cannot overwrite either.
/uuid_v7_c
*.o

# ── Rust ─────────────────────────────────────────────────────────────────────
# uuid_v7.rs is compiled by hand (rustc --edition 2021 -O uuid_v7.rs -o uuid_v7_rs).
/uuid_v7_rs
*.rs.bk
target/
*.dSYM/

# ── Compiled artefacts ───────────────────────────────────────────────────────
*.so
*.dylib

# ── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
*.swp
*~
